# Database
POSTGRES_USER=proxydb
POSTGRES_PASSWORD=change_me
POSTGRES_DB=proxy_checker
DATABASE_URL=postgresql+asyncpg://proxydb:change_me@db:5432/proxy_checker

# Redis
REDIS_URL=redis://redis:6379/0

# Backend
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Scraper Settings
SCRAPE_INTERVAL_SECONDS=10
CHECK_INTERVAL_SECONDS=30
CHECK_CONCURRENCY=500
CHECK_TIMEOUT=10
MAX_FAILURES_BEFORE_DELETE=3
MAX_PROXY_AGE_HOURS=24
RETRY_COUNT=2

# Name.com DNS
NAMECOM_USERNAME=your_namecom_username
NAMECOM_API_TOKEN=your_namecom_api_token

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
